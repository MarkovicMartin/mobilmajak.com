nter;box-shadow:none!important;}\n.mm-finder-combo-list button:hover,.mm-finder-combo-list button:focus,.mm-finder-combo-list button.is-active{background:rgba(47,91,255,.1)!important;color:var(--mm-blue)!important;-webkit-text-fill-color:var(--mm-blue)!important;}\n.mm-finder-combo-empty{padding:.55rem .65rem;color:var(--mm-muted)!important;font-size:.88rem;}\n.mm-finder-combo-trigger,.mm-finder-combo-trigger:hover,.mm-finder-combo-trigger:focus{color:inherit!important;background:transparent!important;box-shadow:none!important;}\n.mm-price{color:var(--mm-blue);font-weight:800;font-size:1.02rem;white-space:nowrap;}\n.mm-finder [data-mm-price]{position:relative;z-index:4;transform:translate(-100%,-8px);}\n.mm-finder-btn{width:100%;margin-top:clamp(.75rem,1.5vh,1rem);position:relative;z-index:2;}\n.mm-finder-char{position:absolute;right:-8px;bottom:-6px;width:clamp(88px,10vw,110px);z-index:3;pointer-events:none;opacity:.95;}\n\n.mm-trust{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(.75rem,1.2vw,1rem);padding:0;position:relative;z-index:1;margin:0;width:min(var(--mm-max),calc(100% - 40px));margin-inline:auto;}\n.mm-metric{position:relative;z-index:1;background:#fff;border:1px solid var(--mm-line);border-radius:16px;padding:clamp(.9rem,1.6vh,1.15rem) clamp(1rem,1.4vw,1.2rem);box-shadow:var(--mm-shadow);}\n.mm-metric strong{display:block;color:var(--mm-navy);font-size:clamp(1.05rem,1.4vw,1.2rem);font-weight:800;}\n.mm-metric span{color:var(--mm-muted);font-size:.84rem;font-weight:600;}\n.mm-section{padding:3.2rem 0;}\n.mm-section-soft{background:var(--mm-lavender);}\n.mm-section-head{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:1.6rem;}\n.mm-section-head h2{margin:.2rem 0 0;color:var(--mm-navy);font-size:clamp(1.6rem,3vw,2.2rem);font-weight:800;letter-spacing:-.03em;}\n.mm-section-head>p{max-width:360px;margin:0;color:var(--mm-muted);}\n.mm-process-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;}\n.mm-process-card{display:grid;grid-template-columns:1.2fr .8fr;gap:1rem;align-items:center;background:#fff;border:1px solid var(--mm-line);border-radius:24px;padding:1.4rem;box-shadow:var(--mm-shadow);overflow:hidden;}\n.mm-process-card.is-accent{background:linear-gradient(145deg,#fff 55%,#ffe6ee);}\n.mm-process-card h3{margin:0 0 .4rem;font-size:1.25rem;font-weight:800;color:var(--mm-navy);}\n.mm-process-card p{margin:0 0 .85rem;color:var(--mm-muted);}\n.mm-process-list{list-style:none;margin:0 0 1rem;padding:0;}\n.mm-process-list li{display:flex;gap:.65rem;align-items:center;margin:.35rem 0;font-weight:700;color:var(--mm-navy);}\n.mm-process-list b{display:grid;place-items:center;width:28px;height:28px;border-radius:8px;background:var(--mm-blue-soft,#e8eeff);color:var(--mm-blue);font-size:.72rem;}\n.mm-process-card img{width:100%;max-width:180px;justify-self:end;}\n.mm-problem-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;}\n.mm-problem-card{display:flex;flex-direction:column;gap:.45rem;padding:1.25rem;border:1px solid var(--mm-line);border-radius:18px;background:#fff;text-decoration:none;color:var(--mm-navy);box-shadow:var(--mm-shadow);transition:transform .15s,border-color .15s;}\n.mm-problem-card:hover{border-color:var(--mm-blue);transform:translateY(-2px);color:var(--mm-navy);}\n.mm-problem-icon{display:grid;place-items:center;width:2.3rem;height:2.3rem;border-radius:12px;background:#e8eeff;color:var(--mm-blue);font-size:1.1rem;}\n.mm-problem-card h3{margin:0;font-size:1.05rem;font-weight:800;}\n.mm-problem-card p{margin:0;color:var(--mm-muted);font-size:.9rem;flex:1;}\n.mm-problem-card span{color:var(--mm-blue);font-weight:800;font-size:.88rem;}\n@media (max-width:980px){\n  .mm-hero{min-height:0;padding:24px 0 20px;}\n  .mm-splash-inner{justify-content:flex-start;}\n  .mm-splash-inner span{flex:1 1 100%;}\n  .mm-hero-grid,.mm-process-grid,.mm-problem-grid{grid-template-columns:1fr;}\n  .mm-trust{grid-template-columns:1fr 1fr;}\n  .mm-section-head{flex-direction:column;align-items:flex-start;}\n  .mm-finder-char{display:none;}\n  .mm-process-card{grid-template-columns:1fr;}\n}\n@media (max-width:560px){\n  .mm-trust{grid-template-columns:1fr;}\n  .mm-splash{font-size:.78rem;}\n}\n</style>\n\n<script>\n/* MM_DEVICES from #mm-devices-json on homepage */\n(function(){\n  function norm(s){return String(s||'').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').replace(/[^a-z0-9]+/g,'');}\n  function el(html){var d=document.createElement('div');d.innerHTML=html.trim();return d.firstChild;}\n  function formatPrice(p){\n    if(p==null||p==='')return '';\n    var n=Number(p); if(!isFinite(n)) return String(p);\n    return n.toLocaleString('cs-CZ')+' Kč';\n  }\n  function collectModels(node){\n    var out=[];\n    function walk(n, brand){\n      var kids=n.children||[];\n      if(!kids.length){ out.push({value:String(n.id),label:n.title,title:n.title,url:n.url,id:n.id,brand:brand}); return; }\n      kids.forEach(function(c){ walk(c, brand||n); });\n    }\n    walk(node, node);\n    return out.sort(function(a,b){return a.label.localeCompare(b.label,'cs');});\n  }\n  function createCombo(mount, opts){\n    mount.innerHTML='';\n    mount.classList.add('mm-finder-combo');\n    var trigger=el('<button type=\"button\" class=\"mm-finder-combo-trigger\"><span><strong>'+opts.placeholder+'</strong><small>'+opts.hint+'</small></span></button>');\n    var panel=el('<div class=\"mm-finder-combo-panel\"><input type=\"search\" placeholder=\"Psát pro hledání…\" autocomplete=\"off\"><ul class=\"mm-finder-combo-list\"></ul></div>');\n    mount.appendChild(trigger); mount.appendChild(panel);\n    var input=panel.querySelector('input'); var listEl=panel.querySelector('ul');\n    var options=[]; var value=''; var enabled=true;\n    function close(){ mount.classList.remove('is-open'); }\n    function open(){\n      if(!enabled) return;\n      document.querySelectorAll('.mm-finder-combo.is-open').forEach(function(c){ if(c!==mount) c.classList.remove('is-open'); });\n      mount.classList.add('is-open'); input.value=''; render(''); input.focus();\n    }\n    function render(q){\n      var nq=norm(q); listEl.innerHTML='';\n      var filtered=options.filter(function(o){return !nq || norm(o.label).indexOf(nq)>=0;});\n      if(!filtered.length){ listEl.appendChild(el('<li class=\"mm-finder-combo-empty\">Nic nenalezeno</li>')); return; }\n      filtered.slice(0,80).forEach(function(o){\n        var li=document.createElement('li');\n        var b=el('<button type=\"button\"></button>'); b.textContent=o.label;\n        if(String(o.value)===String(value)) b.classList.add('is-active');\n        b.addEventListener('click', function(){ value=o.value; trigger.querySelector('strong').textContent=o.label; close(); opts.onChange(o); });\n        li.appendChild(b); listEl.appendChild(li);\n      });\n    }\n    trigger.addEventListener('click', function(){ mount.classList.contains('is-open')?close():open(); });\n    input.addEventListener('input', function(){ render(input.value); });\n    return {\n      setOptions:function(next){\n        options=next||[]; enabled=options.length>0; mount.classList.toggle('is-disabled',!enabled);\n        value=''; trigger.querySelector('strong').textContent=opts.placeholder;\n      },\n      setValue:function(val){\n        var opt=options.find(function(o){return String(o.value)===String(val);});\n        if(!opt) return false; value=opt.value; trigger.querySelector('strong').textContent=opt.label; opts.onChange(opt); return true;\n      }\n    };\n  }\n\n  function parseServicesFromHtml(html, modelTitle){\n    var doc=document.implementation.createHTMLDocument('');\n    doc.documentElement.innerHTML=html;\n    var out=[]; var seen={};\n    doc.querySelectorAll('a[href]').forEach(function(a){\n      var href=a.getAttribute('href')||'';\n      if(!href || href.indexOf('/zarizeni/')>=0) return;\n      if(href.indexOf('http')!==0 && href.charAt(0)!=='/') return;\n      // product-like: no many path segments that are category\n      var path=(href.split('?')[0]||'');\n      if(/\\/(pobocky|vyhledavani|hodnoceni|blog|vyzvednuti)/i.test(path)) return;\n      var card=a.closest('.mm-service-row, .mm-svc-card, .card');\n      if(!card) return;\n      var title=(card.querySelector('.mm-service-main strong, h4,h3,.card-title')||a).textContent.trim();\n      if(!title || title.length<4) return;\n      var priceEl=card.querySelector('.mm-service-price, [style*=\"font-weight: 800\"], .mm-svc-price, .card-body span');\n      var priceTxt='';\n      if(priceEl){\n        var t=priceEl.textContent.trim();\n        if(/\\d/.test(t) && /Kč|Kc|CZK/i.test(t)) priceTxt=t;\n      }\n      // better: find Kč in card\n      if(!priceTxt){\n        var m=card.textContent.match(/(\\d[\\d\\s]*\\d|\\d)\\s*Kč/);\n        if(m) priceTxt=m[0];\n      }\n      var key=href.replace(/#.*/,'');\n      if(seen[key]) return; seen[key]=1;\n      var abs=a.href;\n      if(/servismajak\\.cz\\/(zarizeni|pobocky|vyhledavani|hodnoceni)/i.test(abs)) return;\n      if(!/servismajak\\.cz\\//i.test(abs)) return;\n      // skip pure category\n      if(/\\/zarizeni(\\/|$)/i.test(abs)) return;\n      out.push({value:key,label:title.replace(/\\s+/g,' ').trim(),href:abs,price:priceTxt,rawPrice:priceTxt});\n    });\n    // prefer cards with Rezervovat nearby\n    if(!out.length){\n      doc.querySelectorAll('.mm-service-row, .mm-svc-card, .card.card-transition').forEach(function(card,i){\n        var a=card.querySelector('a[href]');\n        if(!a) return;\n        var href=a.href;\n        if(/\\/zarizeni\\//i.test(href)) return;\n        var title=(card.querySelector('.mm-service-main strong, h4,h3')||a).textContent.trim();\n        var m=card.textContent.match(/(\\d[\\d\\s]*\\d|\\d)\\s*Kč/);\n        out.push({value:href,label:title,href:href,price:m?m[0]:'',rawPrice:m?m[0]:''});\n      });\n    }\n    // unique by href\n    var u={}, res=[];\n    out.forEach(function(o){ if(u[o.href]) return; u[o.href]=1; res.push(o); });\n    return res;\n  }\n\n  function initFinder(){\n    var root=document.querySelector('[data-mm-finder]');\n    if(!root) return;\n    var roots=(window.MM_DEVICES&&MM_DEVICES.roots)||[];\n    var priceEl=root.querySelector('[data-mm-price]');\n    var btn=root.querySelector('[data-mm-btn]');\n    var selectedType=null, selectedBrand=null, selectedModel=null, selectedService=null;\n\n    function syncBtn(){\n      if(!btn) return;\n      if(selectedService && selectedService.href){ btn.href=selectedService.href; btn.textContent='Zobrazit detail opravy'; }\n      else if(selectedModel && selectedModel.url){ btn.href='/zarizeni/'+selectedModel.url; btn.textContent='Zobrazit opravy modelu'; }\n      else if(selectedBrand && selectedBrand.url){ btn.href='/zarizeni/'+selectedBrand.url; btn.textContent='Zobrazit značku'; }\n      else { btn.href='/zarizeni/'; btn.textContent='Vybrat v katalogu'; }\n    }\n\n    var serviceCombo=createCombo(root.querySelector('[data-mm-combo=\"service\"]'),{\n      hint:'Vybraná oprava', placeholder:'Vyberte opravu',\n      onChange:function(opt){ selectedService=opt; if(priceEl) priceEl.textContent=opt.price||''; syncBtn(); }\n    });\n    var modelCombo=createCombo(root.querySelector('[data-mm-combo=\"model\"]'),{\n      hint:'Vybraný model', placeholder:'Vyberte model',\n      onChange:function(opt){\n        selectedModel=opt; selectedService=null; if(priceEl) priceEl.textContent='';\n        serviceCombo.setOptions([{value:'_',label:'Načítám opravy…'}]);\n        syncBtn();\n        var url='/zarizeni/'+(opt.url||'');\n        fetch(url,{credentials:'same-origin'}).then(function(r){return r.text();}).then(function(html){\n          var list=parseServicesFromHtml(html, opt.title);\n          if(!list.length){\n            serviceCombo.setOptions([]);\n            if(priceEl) priceEl.textContent='';\n            return;\n          }\n          serviceCombo.setOptions(list);\n        }).catch(function(){ serviceCombo.setOptions([]); });\n      }\n    });\n    var brandCombo=createCombo(root.querySelector('[data-mm-combo=\"brand\"]'),{\n      hint:'Vybraná značka', placeholder:'Vyberte značku',\n      onChange:function(opt){\n        selectedBrand=opt.node; selectedModel=null; selectedService=null; if(priceEl) priceEl.textContent='';\n        modelCombo.setOptions(collectModels(opt.node));\n        serviceCombo.setOptions([]);\n        syncBtn();\n      }\n    });\n    var typeCombo=createCombo(root.querySelector('[data-mm-combo=\"type\"]'),{\n      hint:'Typ zařízení', placeholder:'Vyberte typ',\n      onChange:function(opt){\n        selectedType=opt.node; selectedBrand=null; selectedModel=null; selectedService=null; if(priceEl) priceEl.textContent='';\n        var brands=(opt.node.children||[]).slice().sort(function(a,b){return a.title.localeCompare(b.title,'cs');});\n        brandCombo.setOptions(brands.map(function(b){return {value:String(b.id),label:b.title,node:b};}));\n        modelCombo.setOptions([]); serviceCombo.setOptions([]); syncBtn();\n      }\n    });\n    typeCombo.setOptions(roots.map(function(r){return {value:String(r.id),label:r.title,node:r};}));\n    brandCombo.setOptions([]); modelCombo.setOptions([]); serviceCombo.setOptions([]); syncBtn();\n    document.addEventListener('click', function(e){\n      if(e.target.closest('.mm-finder-combo')) return;\n      document.querySelectorAll('.mm-finder-combo.is-open').forEach(function(c){c.classList.remove('is-open');});\n    });\n    // default: phones\n    if(roots[0]) typeCombo.setValue(String(roots[0].id));\n  }\n\n  function initChrome(){\n    var oldAnnounce=document.getElementById('mm-announce');\n    if(oldAnnounce) oldAnnounce.remove();\n    var isHome = !!document.getElementById('mm-home') || location.pathname==='/' || /\\/index\\.php$/i.test(location.pathname);\n    if(isHome){\n      document.body.classList.add('mm-is-home');\n      // hide legacy home blocks (image, delivery, zanést, o nás stats if outside mm-home)\n      document.querySelectorAll('.container.container-xxl .row > [class*=\"col\"]').forEach(function(col){\n        if(col.querySelector('#mm-home')) return;\n        // keep branches heading / SYS-9 cards\n        var t=(col.textContent||'');\n        if(/Najděte nejbližší|Mobil Maják -/i.test(t) && col.querySelector('.card')) return;\n        if(col.querySelector('#mm-home')) return;\n        // hide if it's the old side image / delivery / zanést / o nás\n        if(col.querySelector('img[src*=\"DSC03316\"], img[src*=\"Prodejce\"], img[src*=\"Majak_4\"]') && !col.querySelector('#mm-home')){\n          // might be delivery - hide\n        }\n        if(!col.querySelector('#mm-home') && (\n          col.querySelector('img[src*=\"DSC03316\"]') ||\n          /Vyzvednutí zdarma|Opraveno za hodinu|Vaše zařízení můžete zdarma poslat|Vaše zařízení k nám můžete přinést|Tisíce baterií|Tisíce displejů/i.test(t)\n        )){\n          col.classList.add('mm-hide-legacy');\n        }\n      });\n    }\n    $('#myrepair-nav-chooseDevice').html('<a href=\"https://servismajak.cz/zarizeni/\" class=\"btn btn-primary btn-sm\">Vybrat zařízení</a>');\n    $('#myrepair-nav-main').html('');\n    $('img.img-fluid').each(function(){ if($(this).attr('src')==='') $(this).hide(); });\n\n    // top search product suggest\n    (function(){\n      var $input=$('.js-form-search').first(); if(!$input.length) return;\n      var $form=$input.closest('form.site-search'); if(!$form.length) return;\n      var $box=$('<div class=\"mm-search-suggest\" role=\"listbox\"></div>'); $form.append($box);\n      var timer=null,lastQ='';\n      function parseProducts(html){\n        var doc=document.implementation.createHTMLDocument(''); doc.documentElement.innerHTML=html; var out=[];\n        doc.querySelectorAll('[data-search-section=\"products\"] a.site-search-result').forEach(function(a){\n          var titleEl=a.querySelector('.site-search-result-title'); var metaEl=a.querySelector('.site-search-result-meta');\n          var title=titleEl?titleEl.textContent.trim():(a.textContent||'').trim();\n          var price=metaEl?metaEl.textContent.trim():'';\n          if(title&&a.href) out.push({title:title,price:price,href:a.href});\n        }); return out;\n      }\n      function render(items){\n        if(!items.length){$box.removeClass('is-open').empty();return;}\n        $box.html(items.slice(0,7).map(function(p){\n          return '<a href=\"'+p.href+'\"><span>'+$('<div>').text(p.title).html()+'</span>'+(p.price?'<span class=\"mm-price\">'+$('<div>').text(p.price).html()+'</span>':'')+'</a>';\n        }).join('')).addClass('is-open');\n      }\n      $input.on('input', function(){\n        var q=($input.val()||'').trim(); clearTimeout(timer);\n        timer=setTimeout(function(){\n          if(q.length<2){render([]);return;} if(q===lastQ)return; lastQ=q;\n          $.get('/ajax/search',{q:q}).done(function(html){render(parseProducts(html));}).fail(function(){render([]);});\n        },220);\n      });\n      $input.on('focus', function(){ if($box.children().length) $box.addClass('is-open'); });\n      $(document).on('click', function(e){ if(!$(e.target).closest($form).length) $box.removeClass('is-open'); });\n    })();\n\n    initFinder();\n  }\n\n  if(window.jQuery){ jQuery(document).ready(initChrome); }\n  else { document.addEventListener('DOMContentLoaded', initChrome); }\n})();\n</script>\n", "analytics": "", "advertising": "", "footer": ""}}