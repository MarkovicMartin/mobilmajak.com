# Microsoft Clarity – Project ID z https://clarity.microsoft.com (Settings → Setup)
# Zkopírujte jako .env.production před npm run build (deploy).
# Lokálně volitelně .env.local – bez ID se Clarity nenačte.
REACT_APP_CLARITY_PROJECT_ID=

# Finance modul (admin) – lokálně .env.local: REACT_APP_FINANCE_ENABLED=1
# Produkční build: REACT_APP_FINANCE_ENABLED=1 ve frontend/.env.production
# REACT_APP_FINANCE_ENABLED=1
